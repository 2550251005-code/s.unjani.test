<!doctype html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="light" data-sidebar-size="lg"
    data-sidebar-image="none" data-preloader="disable">

<head>

    <meta charset="utf-8" />
    <title>Update Link | S.UNJANI</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="S.UNJANI Short Link Url Universitas Jenderal Achmad Yani" name="description" />
    <meta content="Wildan Pratama, S.Kom." name="author" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="/public/assets/images/favicon.ico">

    <!-- Layout config Js -->
    <script src="/public/assets/js/layout.js"></script>
    <!-- Bootstrap Css -->
    <link href="/public/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="/public/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css-->
    <link href="/public/assets/css/app.min.css" rel="stylesheet" type="text/css" />
    <!-- custom Css-->
    <link href="/public/assets/css/custom.min.css" rel="stylesheet" type="text/css" />
    <!-- Font Awesome -->
    <script src="/public/assets/js/font-awesome.js"></script>


</head>

<body>

    <!-- Begin page -->
    <div id="layout-wrapper">

        <!-- Header -->
        <%- include('../partials/header') %>
        <!-- /Header -->


        <!-- ========== App Menu ========== -->
        <!-- Menu -->
        <%- include('../partials/menu') %>
        <!-- /Menu -->
        <!-- Left Sidebar End -->
        <!-- Vertical Overlay-->
        <div class="vertical-overlay"></div>

        <!-- ============================================================== -->
        <!-- Start right Content here -->
        <!-- ============================================================== -->
        <div class="main-content">

            <div class="page-content">
                <div class="container-fluid">

                    <!-- start page title -->
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                                <h4 class="mb-sm-0">Update Link</h4>

                                <div class="page-title-right">
                                    <ol class="breadcrumb m-0">
                                        <li class="breadcrumb-item"><a href="javascript: void(0);">Link</a></li>
                                        <li class="breadcrumb-item active">Update</li>
                                    </ol>
                                </div>

                            </div>
                        </div>
                    </div>
                    <!-- end page title -->
                    <div class="row">
                        <div class="col-xl-10">
                            <div class="card">
                                <div class="card-body">
                                    <form action="/users/link/update" method="post">
                                        <div class="mb-3">
                                            <input hidden readonly id="slug" name="slug"
                                                value="<%- link._id %>">
                                            <label for="employeeUrl" class="form-label">URL</label>
                                            <input type="url" class="form-control" id="link" name="link"
                                                value="<%- link.link %>">
                                        </div>
                                        <div class="mb-3">
                                            <label for="StartleaveDate" class="form-label">Short Link</label>
                                            <div class="input-group">
                                                <span class="input-group-text"
                                                    id="basic-addon3">https://s.unjani.ac.id/</span>
                                                <input type="text" class="form-control" id="alias" name="alias"
                                                    aria-describedby="basic-addon3" minlength="3"
                                                    value="<%- link.alias %>">
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-xl-6">
                                                <label for="basic-url" class="form-label">Redirect</label>
                                                <select class="form-select mb-3" aria-label="Default select example"
                                                    name="referer" id="referer" required>
                                                    <option value="direct" <% if(link.referer == 'direct'){ %> selected <% }%> >Direct</option>
                                                    <option value="splash" <% if(link.referer == 'splash'){ %> selected <% }%> >Splash</option>
                                                </select>
                                            </div>
                                            <div class="col-xl-6">
                                                <label for="exampleInputdate" class="form-label">Expired</label>
                                                <input type="date" class="form-control" id="expired" name="expired" value="<%- link.dateExpired %>">
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-xl-6">
                                                <label for="exampleInputpassword" class="form-label">Password</label>
                                                <input minlength="5" type="password" class="form-control" id="password"
                                                    name="password" placeholder="Isi jika ingin menambahkan atau mengganti password">
                                            </div>
                                            <div class="col-xl-6">
                                                <label for="deskripsi" class="form-label">Deskripsi</label>
                                                <input type="text" class="form-control" id="deskripsi" name="deskripsi" value="<%- link.deskripsi %>"
                                                    placeholder="Deskripsi link (optional)">
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i> Update Link</button>
                                        </div>
                                </div>
                            </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2">

                </div>
            </div>

        </div>
        <!-- container-fluid -->
    </div>
    <!-- End Page-content -->

    <!-- Footer -->
    <%- include('../partials/footer') %>
    <!-- end main content-->

    </div>
    <!-- END layout-wrapper -->



    <!--start back-to-top-->
    <button onclick="topFunction()" class="btn btn-danger btn-icon" id="back-to-top">
        <i class="ri-arrow-up-line"></i>
    </button>
    <!--end back-to-top-->

    <!--preloader-->
    <div id="preloader">
        <div id="status">
            <div class="spinner-border text-primary avatar-sm" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT -->
    <script src="/public/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/public/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="/public/assets/libs/node-waves/waves.min.js"></script>
    <script src="/public/assets/libs/feather-icons/feather.min.js"></script>
    <script src="/public/assets/js/pages/plugins/lord-icon-2.1.0.js"></script>
    <script src="/public/assets/js/plugins.js"></script>

    <!-- App js -->
    <script src="/public/assets/js/app.js"></script>
</body>

</html>