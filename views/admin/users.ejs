            <script>
                let tabel = $('#ajax-datatable').DataTable({
                    "processing": true,
                    "serverSide": true,
                    "fixedColumns": {
                        "right": 1 // Mengunci kolom "Aksi" di bagian kanan
                    },
                    "ajax": {
                        "url": "/api/users",
                        "type": "POST",
                        "error": function (xhr, error, code) {
                            console.log(xhr); // Lihat respon dari server
                            console.log(error); // Pesan kesalahan
                            console.log(code); // Status kesalahan
                        }
                    },
                    "columns": [{
                            "data": null,
                            "render": (data, type, row, meta) => meta.row + 1
                        }, // No.
                        {
                            "data": "nip"
                        }, // NIP
                        {
                            "data": "namaLengkap"
                        }, // Nama Lengkap
                        {
                            "data": "unitKerja"
                        }, // Unit Kerja
                        {
                            "data": "email"
                        }, // Email
                        {
                            "data": "role"
                        }, // Role
                        {
                            "data": "aksi"
                        }
                    ]
                });

                function copyLink(link, buttonID) {
                    navigator.clipboard.writeText(link).then(function () {
                        // Ubah teks dari buttonText menjadi "Copied"
                        $('#' + buttonID).text('Copied');
                        setTimeout(function () {
                            $('#' + buttonID).text("Copy");
                        }, 2000);
                    }, function (err) {
                        console.error("Error copying text: ", err);
                    });
                }

                function changeUpdate(name, nomorInduk, unitKerja, homebase, role, email, type = 'Tendik', jabatanFungsional = '') {
                    $('#name').val(name);
                    $('#nomorInduk').val(nomorInduk);
                    $('#email').val(email);
                    $('#unitKerja').val(unitKerja).trigger('change');
                    $('#homebase').val(homebase).trigger('change');
                    $('#role').val(role).trigger('change');
                    $('#type').val(type).trigger('change');
                    $('#jabatanFungsional').val(jabatanFungsional);
                }


                function changeHapus(n, d) {

                    $('#nameHapus').val(n);
                    $('#csrf').val(d);
                }

                function openReset(id, email, name) {
                    $('#resetUserId').val(id);
                    $('#resetUserEmail').val(email);
                    $('#resetPassword').val('');
                    $('#resetPasswordConfirm').val('');
                    $('#resetUserLabel').text(`${name} (${email})`);
                }

                function isStrongPassword(password) {
                    return /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{6,}$/.test(password);
                }

                function resetPassword() {
                    const userId = $('#resetUserId').val();
                    const password = $('#resetPassword').val();
                    const confirmPassword = $('#resetPasswordConfirm').val();

                    if (!password || !confirmPassword) {
                        Swal.fire({
                            title: "Gagal!",
                            text: "Password baru dan konfirmasi wajib diisi.",
                            icon: "error",
                            confirmButtonText: '<i class="fa-solid fa-badge-check"></i> OK',
                            customClass: {
                                confirmButton: 'btn-primary btn'
                            }
                        });
                        return;
                    }

                    if (password !== confirmPassword) {
                        Swal.fire({
                            title: "Gagal!",
                            text: "Konfirmasi password tidak sama.",
                            icon: "error",
                            confirmButtonText: '<i class="fa-solid fa-badge-check"></i> OK',
                            customClass: {
                                confirmButton: 'btn-primary btn'
                            }
                        });
                        return;
                    }

                    if (!isStrongPassword(password)) {
                        Swal.fire({
                            title: "Gagal!",
                            text: "Password minimal 6 karakter dan harus mengandung huruf besar, huruf kecil, angka, serta karakter khusus.",
                            icon: "error",
                            confirmButtonText: '<i class="fa-solid fa-badge-check"></i> OK',
                            customClass: {
                                confirmButton: 'btn-primary btn'
                            }
                        });
                        return;
                    }

                    $.post(`/admin/users/${userId}/reset-password`, {
                        password: password
                    }, function (response, status) {
                        if (status === 'success' && response && response.success) {
                            const modalElement = document.getElementById('modalReset');
                            if (modalElement) {
                                const modalInstance = bootstrap.Modal.getInstance(modalElement);
                                if (modalInstance) {
                                    modalInstance.hide();
                                }
                            }

                            Swal.fire({
                                title: "Berhasil!",
                                text: response.message || 'Password berhasil direset.',
                                icon: "success",
                                confirmButtonText: '<i class="fa-solid fa-badge-check"></i> OK',
                                customClass: {
                                    confirmButton: 'btn-primary btn'
                                }
                            }).then(() => {
                                tabel.ajax.reload(null, false);
                            });
                        } else if (response && response.errors) {
                            const errorMessages = response.errors.map(error => error.msg).join('');
                            Swal.fire({
                                title: "Gagal!",
                                text: errorMessages,
                                icon: "error",
                                confirmButtonText: '<i class="fa-solid fa-badge-check"></i> OK',
                                customClass: {
                                    confirmButton: 'btn-primary btn'
                                }
                            });
                        }
                    }).fail(function (xhr) {
                        let message = "Terjadi kesalahan dalam proses reset password.";
                        if (xhr.responseJSON && xhr.responseJSON.errors) {
                            message = xhr.responseJSON.errors.map(error => error.msg).join('');
                        }
                        Swal.fire({
                            title: "Gagal!",
                            text: message,
                            icon: "error",
                            confirmButtonText: '<i class="fa-solid fa-badge-check"></i> OK',
                            customClass: {
                                confirmButton: 'btn-primary btn'
                            }
                        });
                    });
                }

                function hapus() {
                    let nomorInduk = $('#csrf').val();
                    $.post("/admin/delUser", {
                            nomorInduk: nomorInduk
                        },
                        function (data, status) {
                            if (status === 'success') {
                                // Tampilkan SweetAlert jika berhasil
                                Swal.fire({
                                    title: "Berhasil!",
                                    text: "User telah berhasil dihapus!",
                                    icon: "success",
                                    confirmButtonText: '<i class="fa-solid fa-badge-check"></i> OK',
                                    customClass: {
                                        confirmButton: 'btn-primary btn' // Kelas CSS untuk tombol
                                    }
                                }).then(() => {
                                    // Reload tabel setelah alert
                                    tabel.ajax.reload(null, false);
                                });
                            } else {
                                // Tampilkan SweetAlert jika ada validasi error dari server
                                let errorMessages = response.errors.map(error => error.msg).join('\n');
                                Swal.fire({
                                    title: "Gagal!",
                                    text: `Terjadi kesalahan saat menghapus user:\n${errorMessages}`,
                                    icon: "error",
                                    confirmButtonText: '<i class="fa-solid fa-badge-check"></i> OK',
                                    customClass: {
                                        confirmButton: 'btn-primary btn' // Kelas CSS untuk tombol
                                    }
                                });
                            }
                        }).fail(function (xhr) {
                        // Handle error saat request gagal
