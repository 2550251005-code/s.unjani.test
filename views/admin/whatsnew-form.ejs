<!DOCTYPE html>
<html lang="en" dir="ltr" data-bs-theme="light" data-color-theme="Blue_Theme" data-layout="vertical"
    data-boxed-layout="full">

<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" type="image/png" href="/public/assets/images/logos/favicon.png" />
    <script src="/public/assets/js/fontawesome/font-awesome.js"></script>
    <link rel="stylesheet" href="/public/assets/css/styles.css" />
    <title><%= mode === 'edit' ? 'Edit Pembaruan' : 'Tambah Pembaruan' %> - S UNJANI</title>
</head>

<body>
    <div class="preloader">
        <img src="/public/assets/images/logos/favicon.ico" alt="loader" class="lds-ripple img-fluid" />
    </div>
    <div id="main-wrapper">
        <%- include('../partials/aside') %>
        <div class="page-wrapper">
            <%- include('../partials/header') %>
            <div class="body-wrapper">
                <div class="container-fluid">
                    <%
                        const isEdit = mode === 'edit';
                        const formAction = isEdit && entry._id ? ('/admin/whatsnew/' + entry._id + '/update') : '/admin/whatsnew';
                        const submitLabel = isEdit ? 'Simpan Perubahan' : 'Simpan Pembaruan';
                    %>
                    <div class="card bg-primary-subtle shadow-none position-relative overflow-hidden mb-4">
                        <div class="card-body px-4 py-3">
                            <div class="row align-items-center">
                                <div class="col-9">
                                    <h4 class="fw-semibold mb-8"><%= isEdit ? 'Edit' : 'Tambah' %> What's New
                                        <i class="fa-solid fa-bullhorn text-primary ms-2"></i>
                                    </h4>
                                    <nav aria-label="breadcrumb">
                                        <ol class="breadcrumb">
                                            <li class="breadcrumb-item">
                                                <a class="text-muted text-decoration-none" href="/">Menu</a>
                                            </li>
                                            <li class="breadcrumb-item">
                                                <a class="text-muted text-decoration-none" href="/admin/whatsnew">What's New</a>
                                            </li>
                                            <li class="breadcrumb-item" aria-current="page"><%= isEdit ? 'Edit' : 'Tambah' %></li>
                                        </ol>
                                    </nav>
                                </div>
                                <div class="col-3">
                                    <div class="text-center mb-n5">
                                        <img src="/public/assets/images/breadcrumb/ChatBc.png" alt="modernize-img" class="img-fluid mb-n4">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-body">
                            <form action="<%= formAction %>" method="POST">
                                <div class="row g-4">
                                    <div class="col-lg-6">
                                        <label class="form-label">Judul <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" name="title" placeholder="Contoh: Penambahan Fitur Manajemen Bio"
                                            value="<%= entry.title %>" required>
                                    </div>
                                    <div class="col-lg-3">
                                        <label class="form-label">Jenis Pembaruan</label>
                                        <select class="form-select" name="type">
                                            <option value="added" <%= entry.type === 'added' ? 'selected' : '' %>>Ditambahkan</option>
                                            <option value="updated" <%= entry.type === 'updated' ? 'selected' : '' %>>Diperbarui</option>
                                            <option value="removed" <%= entry.type === 'removed' ? 'selected' : '' %>>Dihapus</option>
                                        </select>
                                    </div>
                                    <div class="col-lg-3">
                                        <label class="form-label">Versi</label>
                                        <input type="text" class="form-control" name="version" placeholder="v0.1.9.2"
                                            value="<%= entry.version %>">
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Deskripsi <span class="text-danger">*</span></label>
                                        <textarea class="form-control" name="description" rows="5" placeholder="Jelaskan ringkasan pembaruan dan manfaatnya..." required><%= entry.description %></textarea>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Tag</label>
                                        <input type="text" class="form-control" name="tags" placeholder="contoh: admin,bugfix"
                                            value="<%= entry.tags || '' %>">
                                        <small class="text-muted">Pisahkan tag dengan koma untuk memudahkan kategorisasi.</small>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end mt-4">
                                    <a class="btn btn-light me-2" href="/admin/whatsnew">Batal</a>
                                    <button class="btn btn-primary" type="submit"><%= submitLabel %></button>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
            <%- include('../partials/menu') %>

        </div>
    </div>

    <script src="/public/assets/js/vendor.min.js"></script>
    <script src="/public/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/public/assets/libs/simplebar/dist/simplebar.min.js"></script>
    <script src="/public/assets/js/theme/app.init.js"></script>
    <script src="/public/assets/js/theme/theme.js"></script>
    <script src="/public/assets/js/theme/app.min.js"></script>
    <script src="/public/assets/js/theme/sidebarmenu.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        (function () {
            const rawSuccess = JSON.parse(`<%- JSON.stringify(success_msg || []) %>`);
            const rawError = JSON.parse(`<%- JSON.stringify(error_msg || []) %>`);
            const rawDanger = JSON.parse(`<%- JSON.stringify(error || []) %>`);
            const toArray = (value) => Array.isArray(value) ? value : (value ? [value] : []);

            const successMessages = toArray(rawSuccess).filter(Boolean);
            const errorMessages = [...toArray(rawError), ...toArray(rawDanger)].filter(Boolean);

            if (successMessages.length) {
                Swal.fire({
                    icon: 'success',
                    title: 'Berhasil',
                    html: successMessages.join('<br>'),
                    confirmButtonText: '<i class="fa-solid fa-badge-check"></i> OK',
                    customClass: { confirmButton: 'btn btn-primary' },
                    buttonsStyling: false
                });
            }

            if (errorMessages.length) {
                Swal.fire({
                    icon: 'error',
                    title: 'Gagal',
                    html: errorMessages.join('<br>'),
                    confirmButtonText: '<i class="fa-solid fa-badge-check"></i> OK',
                    customClass: { confirmButton: 'btn btn-primary' },
                    buttonsStyling: false
                });
            }
        })();
    </script>
</body>

</html>
