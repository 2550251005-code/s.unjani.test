<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= metaDescription %>" />
  <link rel="shortcut icon" type="image/png" href="/public/assets/images/logos/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Sora:wght@500;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --page-bg: #071a2b;
      --glass: rgba(255, 255, 255, 0.08);
      --glass-border: rgba(255, 255, 255, 0.18);
      --text-main: #f8fbff;
      --text-muted: rgba(240, 247, 255, 0.78);
      --accent: #3cc4f0;
      --accent-strong: #1199c9;
      --shadow-lg: 0 22px 55px rgba(2, 12, 24, 0.5);
      --radius-xl: 26px;
      --radius-lg: 18px;
      --radius-md: 14px;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: "Manrope", system-ui, -apple-system, Segoe UI, Roboto, Arial, Helvetica, sans-serif;
      color: var(--text-main);
      background:
        radial-gradient(880px 560px at 14% -8%, rgba(92, 214, 255, 0.35) 0%, transparent 68%),
        radial-gradient(840px 560px at 92% 8%, rgba(84, 165, 255, 0.26) 0%, transparent 66%),
        linear-gradient(150deg, #07182a 0%, #0a2942 45%, #081d30 100%);
    }

    .layout {
      width: min(1180px, 92vw);
      margin: 0 auto;
      padding: 36px 0 56px;
    }

    .hero {
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.06));
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-lg);
      padding: clamp(26px, 4vw, 42px);
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: 26px;
      backdrop-filter: blur(10px) saturate(150%);
    }

    .hero-kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(10, 42, 70, 0.45);
      border: 1px solid rgba(162, 225, 255, 0.36);
      font-weight: 700;
      letter-spacing: 0.05em;
      font-size: 0.76rem;
      text-transform: uppercase;
      color: #c7eeff;
      margin-bottom: 16px;
    }

    .hero h1 {
      margin: 0 0 14px;
      font-family: "Sora", "Manrope", sans-serif;
      font-size: clamp(1.85rem, 4vw, 3.1rem);
      line-height: 1.1;
      letter-spacing: -0.02em;
      max-width: 17ch;
    }

    .hero p {
      margin: 0;
      color: var(--text-muted);
      font-size: 1rem;
      line-height: 1.65;
      max-width: 52ch;
    }

    .hero-search {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 14px;
      background: rgba(6, 28, 46, 0.5);
      border: 1px solid rgba(159, 224, 255, 0.28);
      border-radius: 18px;
      padding: 18px;
    }

    .hero-search label {
      font-size: 0.9rem;
      font-weight: 700;
      color: #d6f2ff;
    }

    .search-row {
      display: flex;
      gap: 10px;
    }

    .search-field {
      flex: 1;
      background: rgba(255, 255, 255, 0.93);
      border: 1px solid rgba(10, 53, 82, 0.2);
      border-radius: 12px;
      padding: 13px 14px;
      font-size: 0.98rem;
      color: #0b2438;
      outline: none;
    }

    .search-field:focus-visible {
      border-color: rgba(17, 153, 201, 0.8);
      box-shadow: 0 0 0 3px rgba(60, 196, 240, 0.24);
    }

    .search-btn {
      border: 0;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--accent), var(--accent-strong));
      color: #052237;
      font-weight: 800;
      padding: 0 18px;
      cursor: pointer;
      transition: transform 0.14s ease, filter 0.14s ease;
      box-shadow: 0 10px 22px rgba(17, 153, 201, 0.35);
    }

    .search-btn:hover { transform: translateY(-1px); filter: brightness(1.04); }
    .search-btn:active { transform: translateY(0); }

    .search-helper {
      margin: 0;
      font-size: 0.82rem;
      color: rgba(224, 246, 255, 0.8);
    }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 12px;
      margin: 34px 0 16px;
    }

    .section-head h2 {
      margin: 0;
      font-family: "Sora", "Manrope", sans-serif;
      font-size: clamp(1.2rem, 2.4vw, 1.7rem);
    }

    .section-head p {
      margin: 0;
      color: var(--text-muted);
      font-size: 0.92rem;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
    }

    .bio-card {
      position: relative;
      overflow: hidden;
      border-radius: var(--radius-lg);
      border: 1px solid rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.08);
      box-shadow: 0 12px 28px rgba(3, 14, 29, 0.38);
      display: flex;
      flex-direction: column;
      min-height: 238px;
      transition: transform 0.15s ease, border-color 0.15s ease;
    }

    .bio-card:hover {
      transform: translateY(-2px);
      border-color: rgba(255, 255, 255, 0.35);
    }

    .bio-card-top {
      min-height: 86px;
      background: var(--card-bg);
      position: relative;
      border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    }

    .bio-card-logo {
      width: 62px;
      height: 62px;
      border-radius: 18px;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.86);
      border: 2px solid rgba(255, 255, 255, 0.62);
      box-shadow: 0 10px 18px rgba(0, 0, 0, 0.22);
      position: absolute;
      left: 14px;
      bottom: -22px;
    }

    .bio-card-logo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .bio-card-body {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 34px 14px 14px;
      flex: 1;
    }

    .bio-card-title {
      margin: 0;
      color: #f8fdff;
      font-size: 1.03rem;
      line-height: 1.35;
      font-weight: 800;
      overflow-wrap: anywhere;
    }

    .bio-card-alias {
      margin: 0;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      width: fit-content;
      padding: 5px 10px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.13);
      color: rgba(236, 247, 255, 0.95);
      font-size: 0.77rem;
      font-weight: 700;
      letter-spacing: 0.01em;
    }

    .bio-card-meta {
      margin: 0;
      color: rgba(231, 245, 255, 0.85);
      font-size: 0.8rem;
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
    }

    .bio-card-meta .dot {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: rgba(244, 252, 255, 0.8);
    }

    .bio-card-cta {
      margin-top: auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      font-weight: 800;
      font-size: 0.9rem;
      border-radius: 10px;
      padding: 10px 12px;
      background: var(--card-btn-bg);
      color: var(--card-btn-text);
      border: 1px solid rgba(255, 255, 255, 0.3);
      box-shadow: 0 10px 18px rgba(0, 0, 0, 0.2);
      transition: transform 0.13s ease;
    }

    .bio-card-cta:hover { transform: translateY(-1px); }

    .empty {
      border-radius: var(--radius-lg);
      border: 1px dashed rgba(173, 225, 250, 0.55);
      background: rgba(10, 34, 52, 0.45);
      padding: 28px;
      text-align: center;
      color: rgba(229, 245, 255, 0.88);
    }

    .empty h3 {
      margin: 0 0 8px;
      font-family: "Sora", "Manrope", sans-serif;
      font-size: 1.18rem;
      color: #f7fcff;
    }

    .empty p { margin: 0; line-height: 1.6; }

    .foot {
      margin-top: 22px;
      text-align: center;
      color: rgba(230, 245, 255, 0.78);
      font-size: 0.82rem;
    }

    .foot a {
      color: #bfe8ff;
      text-decoration: none;
      font-weight: 700;
    }

    .foot a:hover { text-decoration: underline; }

    @media (max-width: 1080px) {
      .hero {
        grid-template-columns: 1fr;
      }

      .cards {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 840px) {
      .cards {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 560px) {
      .layout { width: min(94vw, 560px); }
      .cards { grid-template-columns: 1fr; }
      .search-row { flex-direction: column; }
      .search-btn { padding: 12px 16px; }
    }
  </style>
</head>
<body>
  <div class="layout">
    <section class="hero" aria-label="Pencarian bio">
      <div>
        <span class="hero-kicker">Bio UNJANI</span>
        <h1>Temukan bio resmi dan akses tautan penting dalam satu tempat.</h1>
        <p>
          Gunakan kolom pencarian untuk langsung membuka halaman bio berdasarkan alias,
          atau pilih dari daftar bio terbaru di bawah.
        </p>
      </div>

      <form id="bioSearchForm" class="hero-search" action="/bio" method="get" novalidate>
        <label for="aliasInput">Cari alias bio</label>
        <div class="search-row">
          <input
            id="aliasInput"
            name="alias"
            class="search-field"
            type="text"
            placeholder="contoh: pmbu"
            autocomplete="off"
            required
          />
          <button class="search-btn" type="submit">Buka</button>
        </div>
        <p class="search-helper">Format alias: huruf, angka, dan tanda hubung.</p>
      </form>
    </section>

    <section aria-label="Daftar bio terbaru">
      <div class="section-head">
        <h2>Bio Terbaru</h2>
        <p>Maksimal 8 bio terbaru ditampilkan.</p>
      </div>

      <% if (latestBios && latestBios.length) { %>
        <div class="cards">
          <% latestBios.forEach(function(item) {
               const displayTitle = (item.title || 'Bio').trim();
               const cardTitle = displayTitle.length > 50 ? displayTitle.slice(0, 47) + '...' : displayTitle;
               const createdDate = item.createdAt ? new Date(item.createdAt).toLocaleDateString('id-ID') : '-';
          %>
            <article
              class="bio-card"
              style="--card-bg:<%= item.themePreview.backgroundStyle %>; --card-btn-bg:<%= item.themePreview.buttonColor %>; --card-btn-text:<%= item.themePreview.buttonTextColor %>;"
            >
              <div class="bio-card-top">
                <div class="bio-card-logo" aria-hidden="true">
                  <img src="<%= item.logoUrl %>" alt="Logo <%= cardTitle %>" loading="lazy" />
                </div>
              </div>

              <div class="bio-card-body">
                <h3 class="bio-card-title"><%= cardTitle %></h3>
                <p class="bio-card-alias">/bio/<%= item.alias %></p>
                <p class="bio-card-meta">
                  <span><%= item.linkCount %> tautan</span>
                  <span class="dot" aria-hidden="true"></span>
                  <span><%= createdDate %></span>
                </p>
                <a class="bio-card-cta" href="/bio/<%= item.alias %>" rel="noopener noreferrer">Buka Bio</a>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty">
          <h3>Belum ada bio publik</h3>
          <p>Belum ada data bio untuk ditampilkan saat ini. Silakan cek kembali beberapa saat lagi.</p>
        </div>
      <% } %>
    </section>

    <p class="foot">
      Dikelola melalui <a href="https://s.unjani.ac.id" target="_blank" rel="noopener noreferrer">S UNJANI</a>
    </p>
  </div>

  <script>
    (function () {
      const form = document.getElementById('bioSearchForm');
      const input = document.getElementById('aliasInput');
      if (!form || !input) {
        return;
      }

      const normalizeAlias = (value) => {
        return String(value || '')
          .trim()
          .toLowerCase()
          .replace(/\s+/g, '-')
          .replace(/[^a-z0-9-]/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-|-$/g, '');
      };

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        const alias = normalizeAlias(input.value);
        if (!alias) {
          input.focus();
          return;
        }
        window.location.href = '/bio/' + encodeURIComponent(alias);
      });
    })();
  </script>
</body>
</html>
