              <a href="/contact" class="btn btn-primary btn-lg px-6 py-3 rounded-3 shadow-primary-hover" onclick="return false;">
                Get Started Free <i class="ti ti-chevron-right ms-2"></i>
              </a>
              <a href="#learn-more" class="btn btn-outline-primary btn-lg px-6 py-3 rounded-3">
                Learn More <i class="ti ti-info-circle ms-2"></i>
              </a>
            </div>

            <!-- Stats Card -->
            <div class="mt-8 mb-4 bg-white rounded-4 p-4 shadow-sm d-inline-block" data-aos="zoom-in" data-aos-delay="250">
              <div class="d-flex gap-5">
                <div class="text-center">
                  <div class="fs-7 fw-bold text-primary">15M+</div>
                  <div class="text-muted">Links Generated</div>
                </div>
                <div class="text-center">
                  <div class="fs-7 fw-bold text-primary">98%</div>
                  <div class="text-muted">Customer Satisfaction</div>
                </div>
                <div class="text-center">
                  <div class="fs-7 fw-bold text-primary">1.5B+</div>
                  <div class="text-muted">Clicks Tracked</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Background Elements -->
      <div class="position-absolute top-0 start-0 w-100 h-100 opacity-25">
        <div class="position-absolute end-0 top-n5" style="width: 800px;">
