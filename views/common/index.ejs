    <section class="py-7">
      <div class="container-fluid mt-4">
        <h2 class="display-4 fw-bolder text-center mb-8">Shortlink Essentials</h2>
        <div class="row justify-content-center">
          <div class="col-lg-9">
            <div class="accordion faq-accordion" id="shortlinkFAQ">
              <!-- Question 1 -->
              <div class="accordion-item">
                <h3 class="accordion-header">
                  <button class="accordion-button fs-4" type="button" data-bs-toggle="collapse" 
                    data-bs-target="#collapseOne" aria-expanded="true">
                    <i class="ti ti-currency-free fs-5 me-3"></i>
                    Is SUNJANI free for UNJANI members?
                  </button>
                </h3>
                <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#shortlinkFAQ">
                  <div class="accordion-body">
                    Yes! All UNJANI students and staff get full access to premium features including custom aliases, 
                    QR code generation, and advanced analytics at no cost as part of campus digital services.
                  </div>
                </div>
              </div>
    
              <!-- Question 2 -->
              <div class="accordion-item">
                <h3 class="accordion-header">
                  <button class="accordion-button collapsed fs-4" type="button" data-bs-toggle="collapse" 
                    data-bs-target="#collapseTwo">
                    <i class="ti ti-shield-lock fs-5 me-3"></i>
                    How secure are my shortened links?
                  </button>
                </h3>
                <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#shortlinkFAQ">
                  <div class="accordion-body">
                    We employ military-grade security measures:
                    <ul>
                      <li>SSL encryption for all links</li>
                      <li>Optional password protection</li>
                      <li>Link expiration controls</li>
                      <li>24/7 malware scanning</li>
                    </ul>
