<!DOCTYPE html>
<html lang="en" dir="ltr" data-bs-theme="light" data-color-theme="Blue_Theme" data-layout="vertical">

<head>
  <!-- Required meta tags -->
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Favicon icon-->
  <link rel="shortcut icon" type="image/png" href="/public/assets/images/logos/favicon.png" />

  <!-- Core Css -->
  <script src="/public/assets/js/fontawesome/font-awesome.js"></script>
  <link rel="stylesheet" href="/public/assets/css/styles.css" />

  <title>What's New - SUNJANI</title>
  <!-- Owl Carousel  -->
  <link rel="stylesheet" href="/public/assets/libs/owl.carousel/dist/assets/owl.carousel.min.css" />
</head>

<body>
  <!-- Preloader -->
  <div class="preloader">
    <img src="/public/assets/images/logos/favicon.png" alt="loader" class="lds-ripple img-fluid" />
  </div>
  <!-- ------------------------------------- -->
  <!-- Top Bar Start -->
  <!-- ------------------------------------- -->
  <div class="topbar-image bg-primary py-1 rounded-0 mb-0 alert alert-dismissible fade show" role="alert">
    <div class="d-flex justify-content-center gap-sm-3 gap-2 align-items-center text-center flex-md-nowrap flex-wrap">
      <span class="badge bg-white bg-opacity-10 fs-2 fw-bolder px-2">New</span>
      <p class="mb-0 text-white fw-bold">Lihat highlight pembaruan terkini platform SUNJANI.</p>
    </div>
    <button type="button" class="btn-close btn-close-white p-2 fs-2" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
  <!-- ------------------------------------- -->
  <!-- Header Start -->
  <!-- ------------------------------------- -->
  <%- include('../partials/headerlanding') %>
  <!-- ------------------------------------- -->
  <!-- Responsive Sidebar -->
  <!-- ------------------------------------- -->
  <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel">
    <div class="offcanvas-header">
      <a href="/">
        <img src="/public/assets/images/logos/S UNJANI.png" width="150px" alt="Logo" />
      </a>
      <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
      <ul class="list-unstyled ps-0">
        <li class="mb-1"><a href="/about" class="px-0 fs-4 d-block text-dark link-primary w-100 py-2">About Us</a></li>
        <li class="mb-1"><a href="/apps"
            class="px-0 fs-4 d-flex align-items-center justify-content-start gap-2 w-100 py-2 text-dark link-primary">Other Apps
            <span class="badge text-primary bg-primary-subtle fs-2 fw-bolder hstack">New</span></a></li>
        <li class="mb-1"><a href="/contact" class="px-0 fs-4 d-block w-100 py-2 text-dark link-primary">Contact</a></li>
        <li class="mt-3"><a href="/login" class="btn btn-primary w-100">Log In</a></li>
      </ul>
    </div>
  </div>

  <div class="main-wrapper overflow-hidden">
    <section>
      <div class="bg-primary-subtle py-lg-12 py-5">
        <div class="container-fluid">
          <div class="card bg-primary-subtle shadow-none position-relative overflow-hidden mb-4">
            <div class="card-body px-4 py-3">
              <div class="row align-items-center">
                <div class="col-lg-8 col-12">
                  <h4 class="fw-semibold mb-8">What's New</h4>
                  <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                      <li class="breadcrumb-item"><a class="text-muted text-decoration-none" href="/">Home</a></li>
                      <li class="breadcrumb-item" aria-current="page">Update</li>
                    </ol>
                  </nav>
                </div>
                <div class="col-lg-4 col-12 text-lg-end text-center">
                  <span class="badge bg-white bg-opacity-50 text-primary fw-semibold px-3 py-2">Versi terbaru:
                    <%= latestVersion || 'n/a' %></span>
                </div>
              </div>
            </div>
          </div>

          <% const hasEntries = entries && entries.length; %>
          <% const firstEntry = hasEntries ? entries[0] : null; %>
          <% const otherEntries = hasEntries ? entries.slice(1) : []; %>

          <div class="card overflow-hidden mb-5">
            <% if (firstEntry) { %>
              <div class="position-relative">
                <img src="/public/assets/images/blog/blog-img6.jpg" class="card-img-top rounded-0 object-fit-cover" alt="whats-new"
                  height="420">
                <span class="badge text-bg-light mb-9 me-9 position-absolute bottom-0 end-0"><%= firstEntry.formattedDate %></span>
              </div>
              <div class="card-body p-4">
                <span class="badge bg-<%= firstEntry.type === 'removed' ? 'danger' : firstEntry.type === 'updated' ? 'warning text-dark' : 'success' %> text-uppercase">
                  <%= firstEntry.type %>
                </span>
                <h2 class="fs-8 fw-semibold my-4"><%= firstEntry.title %></h2>
                <div class="d-flex flex-wrap gap-3 align-items-center text-muted">
                  <% if (firstEntry.version) { %>
                    <div class="d-flex align-items-center gap-2">
                      <i class="ti ti-rocket text-dark fs-5"></i> v<%= firstEntry.version %>
                    </div>
                  <% } %>
                  <div class="d-flex align-items-center gap-2">
                    <i class="ti ti-calendar-event text-dark fs-5"></i><%= firstEntry.formattedDate %>
                  </div>
                  <% if (firstEntry.tags && firstEntry.tags.length) { %>
                    <div class="d-flex align-items-center gap-2">
                      <i class="ti ti-tag text-dark fs-5"></i>
                      <span><%= firstEntry.tags.join(', ') %></span>
                    </div>
                  <% } %>
                </div>
              </div>
              <div class="card-body border-top p-4">
                <h3 class="fw-semibold mb-3">Ringkasan</h3>
                <p class="mb-3"><%= firstEntry.description %></p>
              </div>
            <% } else { %>
              <div class="card-body p-5 text-center">
                <img src="/public/assets/images/illustrations/no-data.svg" alt="no update" class="mb-4" width="120">
                <h3 class="fw-semibold mb-2">Belum ada pembaruan</h3>
                <p class="text-muted mb-0">Kabar terbaru akan tampil di sini setelah ada rilis berikutnya.</p>
              </div>
            <% } %>
          </div>

          <% if (otherEntries.length) { %>
            <div class="py-5">
              <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                  <h4 class="fw-semibold mb-1">Riwayat Pembaruan</h4>
                  <p class="mb-0 text-muted">Catatan lengkap tiap perubahan dan perbaikan.</p>
                </div>
                <div class="d-flex gap-2">
                  <span class="badge bg-success-subtle text-success">Ditambahkan</span>
                  <span class="badge bg-warning-subtle text-warning">Diperbarui</span>
                  <span class="badge bg-danger-subtle text-danger">Dihapus</span>
                </div>
              </div>
              <div class="row g-4">
                <% otherEntries.forEach(function(item) { %>
                  <div class="col-lg-4 col-md-6">
                    <div class="card h-100 shadow-sm border">
                      <div class="card-body p-4 d-flex flex-column">
                        <span class="badge bg-<%= item.type === 'removed' ? 'danger' : item.type === 'updated' ? 'warning text-dark' : 'success' %> align-self-start mb-3 text-uppercase">
                          <%= item.type %>
                        </span>
                        <h5 class="fw-semibold mb-2"><%= item.title %></h5>
                        <p class="text-muted small mb-3"><%= item.formattedDate %> <% if (item.version) { %> · v<%= item.version %><% } %></p>
                        <p class="flex-grow-1"><%= item.description.length > 160 ? item.description.slice(0, 157) + '…' : item.description %></p>
                        <% if (item.tags && item.tags.length) { %>
                          <div class="mt-3">
                            <% item.tags.forEach(function(tag) { %>
                              <span class="badge bg-primary-subtle text-primary me-1 mb-1">#<%= tag %></span>
                            <% }) %>
                          </div>
                        <% } %>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>

          <div class="py-5">
            <div class="row g-4 align-items-center">
              <div class="col-lg-7">
                <div class="card border-0 shadow-sm bg-primary-subtle">
                  <div class="card-body p-5">
                    <div class="d-flex align-items-center gap-3 mb-3">
                      <div class="round-54 bg-primary text-white d-grid align-items-center justify-content-center">
                        <i class="ti ti-mail fs-5"></i>
                      </div>
                      <div>
                        <h4 class="fw-semibold mb-1">Tidak ketinggalan update</h4>
                        <p class="mb-0 text-muted">Daftarkan email untuk menerima notifikasi rilis berikutnya.</p>
                      </div>
                    </div>
                    <form class="row g-3 subscription-form">
                      <div class="col-lg-9">
                        <input type="email" class="form-control form-control-lg" placeholder="nama@unjani.ac.id" required>
                      </div>
                      <div class="col-lg-3 d-grid">
                        <button class="btn btn-lg btn-primary" type="submit">Berlangganan</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
              <div class="col-lg-5">
                <div class="card border-0 shadow-sm h-100">
                  <div class="card-body p-5">
                    <h4 class="fw-semibold mb-3">Butuh bantuan?</h4>
                    <p class="text-muted">Hubungi tim SISFO jika Anda memiliki ide fitur atau mengalami kendala setelah
                      pembaruan.</p>
                    <div class="d-flex gap-3 flex-wrap">
                      <a href="mailto:helpdesk.sisfo@unjani.ac.id" class="btn btn-outline-primary px-4">Email Helpdesk</a>
                      <a href="/contact" class="btn btn-primary px-4">Kontak Kami</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Footer -->
    <%- include('../partials/footer-landing') %>
  <!-- Scroll Top -->
  <a href="javascript:void(0)"
    class="top-btn btn btn-primary d-flex align-items-center justify-content-center round-54 p-0 rounded-circle">
    <i class="ti ti-arrow-up fs-7"></i>
  </a>

  <script src="/public/assets/js/vendor.min.js"></script>
  <script src="/public/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/public/assets/libs/simplebar/dist/simplebar.min.js"></script>
  <script src="/public/assets/js/theme/app.init.js"></script>
  <script src="/public/assets/js/theme/theme.js"></script>
  <script src="/public/assets/js/theme/app.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.8/dist/iconify-icon.min.js"></script>
  <script src="/public/assets/libs/owl.carousel/dist/owl.carousel.min.js"></script>
  <script src="/public/assets/js/frontend-landingpage/homepage.js"></script>
  <script>
    document.getElementById('year').innerText = new Date().getFullYear();
  </script>
</body>

</html>
