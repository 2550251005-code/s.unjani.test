PORT=8235
APP_BASE_URL=https://s.unjani.ac.id

# SSO Gateway configuration (must match the SSO service in ../sso)
SSO_BASE_URL=https://sso-sisfo.unjani.ac.id
SSO_CLIENT_ID=replace-with-sso-client-id
SSO_CLIENT_SECRET=replace-with-sso-client-secret
SSO_REDIRECT_URI=https://s.unjani.ac.id/auth/sso/callback
SSO_TRUSTED_ORIGINS=https://sso-sisfo.unjani.ac.id
SSO_PKCE_TTL_MS=600000
# Deprecated (legacy only, no longer required for normal SSO flow)
SSO_JWT_SECRET=
SSO_ADMIN_USERS_PATH=/admin/users
NOREG_APP_URL=http://localhost:3000
OURSISFO_APP_URL=http://localhost:8005
# Tambahan opsional, format: Nama|https://url|Deskripsi|icon-class;Nama Lain|https://url-lain
SSO_APP_LINKS=
# Set ke tanggal lampau agar legacy secretKey dipaksa nonaktif.
RESTAPI_LEGACY_SECRETKEY_UNTIL=2026-02-22T23:59:59+07:00
# Opsional: hanya dipakai jika menjalankan script migrasi manual.
SSO_MIGRATION_TOKEN=
SSO_MIGRATION_SHARED_SECRET=

# Segmen (master data via SSO)
SEGMENT_ENCRYPTION_SECRET=change-me
SEGMENT_SSO_BASE_URL=https://sso-sisfo.unjani.ac.id
SEGMENT_SSO_UNITKERJA_ENDPOINT=/api/master/unitkerja
SEGMENT_SSO_HOMEBASE_ENDPOINT=/api/master/homebase
SEGMENT_SSO_SUBHOMEBASE_ENDPOINT=/api/master/subhomebase
